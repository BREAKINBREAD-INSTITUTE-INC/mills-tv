<?xml version="1.0" encoding="utf-8"?>
<!-- MILLS OS "Deep Space": near-black with one soft pool of light, dark edges. GPU-light. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Base near-black. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#06080B"/>
        </shape>
    </item>

    <!-- 2. Soft pool of light, upper-centre. -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="620dp"
                android:centerX="0.5" android:centerY="0.34"
                android:startColor="#FF121A26" android:centerColor="#660E141C" android:endColor="#0006080B"/>
        </shape>
    </item>

    <!-- 3. Faint gold warmth at the very top, so the brand still reads warm. -->
    <item android:bottom="640dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="#14E0A526" android:endColor="#00000000"/>
        </shape>
    </item>

    <!-- 4. Vignette: pull the far edges to black. -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="880dp"
                android:centerX="0.5" android:centerY="0.42"
                android:startColor="#00000000" android:endColor="#99000000"/>
        </shape>
    </item>
</layer-list>
