<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Frosted pill, tvOS style. -->
    <style name="TopButtonBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@drawable/pill_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:drawablePadding">9dp</item>
        <item name="android:drawableTint">@drawable/pill_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="TopButton" parent="TopButtonBase" />

    <!-- Icon-only chip: just the icon, box shrunk to fit it. -->
    <style name="TopIcon" parent="TopButtonBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:paddingStart">13dp</item>
        <item name="android:paddingEnd">13dp</item>
        <item name="android:drawablePadding">0dp</item>
    </style>

    <style name="GlanceTile">
        <item name="android:layout_width">186dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:padding">22dp</item>
        <item name="android:background">@drawable/glance_tile_bg</item>
    </style>
    <style name="GlanceKey">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textColor">#9AA6B2</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:fontVariationSettings">"'wght' 600"</item>
    </style>
    <style name="GlanceBig">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#F2F4F7</item>
        <item name="android:textSize">44sp</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:fontVariationSettings">"'wght' 300"</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="GlanceSub">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">#9AA6B2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/outfit</item>
    </style>
    <style name="GlanceChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:paddingStart">11dp</item>
        <item name="android:paddingEnd">11dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textColor">#6fe0d2</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:fontVariationSettings">"'wght' 600"</item>
        <item name="android:background">@drawable/glance_chip_bg</item>
    </style>


    <style name="CcCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">26dp</item>
        <item name="android:minHeight">150dp</item>
        <item name="android:background">@drawable/cc_card</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="CcEyebrow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/dim</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:fontVariationSettings">"'wght' 600"</item>
    </style>
    <style name="CcValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:fontVariationSettings">"'wght' 600"</item>
    </style>
    <style name="CcSub">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/dim</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:fontVariationSettings">"'wght' 300"</item>
    </style>
</resources>
