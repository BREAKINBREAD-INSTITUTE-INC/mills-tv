<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5E0A526" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/pill_top" android:endColor="@color/pill_bot" />
            <stroke android:width="1dp" android:color="@color/pill_stroke" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
