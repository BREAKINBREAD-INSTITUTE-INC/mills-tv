<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Needed on Android 10 to read the Wi-Fi network name; granted over adb at install time. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- System view counts every app the cleanup turned off (sideloaded, never on Play). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Theater's Continue Watching reads the TV's Watch Next rows (TvContract) first. A normal
         permission, granted at install; without ACCESS_ALL_EPG_DATA (system-only) the provider
         returns only rows this app wrote, so Theater falls back to its own history (MediaWatcher). -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <!-- Sleep sounds play from a foreground media service (SleepService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Android 11+ package visibility: lets the launcher list the TV apps it shows as tiles. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".MillsApp"
        android:usesCleartextTraffic="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.TvHome"
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Listed in the TV's own app list, so it can be opened from the stock home screen too. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HomeSettingsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- Home button for remotes that send KEYCODE_ALL_APPS (Xiaomi). Opt-in: HOME_KEY_SERVICE=1
             build-and-install.sh; see HomeKeyService. -->
        <service
            android:name=".HomeKeyService"
            android:label="@string/home_key_name"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_key_service" />
        </service>

        <!-- Screensaver: pick it in Settings, or `settings put secure screensaver_components
             com.gathin.tvhome/.ClockDream` over adb. -->
        <service
            android:name=".ClockDream"
            android:label="@string/dream_name"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- The remote's Input button (KEYCODE_TV) opens the input switcher; see InputKeyService. -->
        <service
            android:name=".InputKeyService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/input_key_service" />
        </service>
        <!-- Theater's own Continue Watching. A notification listener only so it may see the TV's
             media sessions; it never reads notifications. Grant once over adb:
             `adb shell cmd notification allow_listener com.gathin.tvhome/com.gathin.tvhome.MediaWatcher`.
             The system rebinds it after a reboot. See MediaWatcher and Watched. -->
        <service
            android:name=".MediaWatcher"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <activity android:name=".SystemActivity" android:exported="false" android:theme="@style/Theme.TvHome" />
        <activity android:name=".NetworkActivity" android:exported="false" android:theme="@style/Theme.TvHome" />
        <activity android:name=".MissionControlActivity" android:exported="false" android:theme="@style/Theme.TvHome" />
        <activity android:name=".AgentActivity" android:exported="false" android:theme="@style/Theme.TvHome" />
        <activity android:name=".MachineActivity" android:exported="false" android:theme="@style/Theme.TvHome" />
        <activity android:name=".DreamPreviewActivity" android:exported="false" android:theme="@style/Theme.TvHome" />
        <activity android:name=".CamerasActivity" android:exported="false" android:theme="@style/Theme.TvHome" />
        <activity android:name=".CameraActivity" android:exported="false" android:theme="@style/Theme.TvHome" />
        <activity android:name=".ClipPlayerActivity" android:exported="false" android:theme="@style/Theme.TvHome" />
        <activity android:name=".HouseActivity" android:exported="false" android:theme="@style/Theme.TvHome" />
        <activity android:name=".QuickMenuActivity" android:exported="false" android:theme="@style/Theme.TvHome" />
        <!-- Theater home page (Settings > Layout > Home page); MainActivity hands over to it. -->
        <activity
            android:name=".TheaterActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.TvHome" />
        <activity android:name=".MillsSettingsActivity" android:exported="false" android:theme="@style/Theme.TvHome" />
        <!-- Sleep: a black screen while SleepService plays an ambient track on a timer. -->
        <activity android:name=".SleepActivity" android:exported="false" android:theme="@style/Theme.TvHome" />
        <service android:name=".SleepService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <activity android:name=".OriginalActivity" android:exported="true" android:theme="@android:style/Theme.NoDisplay" />
    </application>
</manifest>
